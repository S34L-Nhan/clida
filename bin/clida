#!/usr/bin/env bash
# clida: start the local server (if needed) and open the app window. Runs on WSL, macOS and Linux;
# kept to bash 3.2, which is what macOS ships.
set -euo pipefail

# Follow the symlink in ~/.local/bin by hand: older macOS has no `readlink -f`.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
STATE="${CLIDA_HOME:-$HOME/.clida}"
PORT="${CLIDA_PORT:-47321}"
LOG="$STATE/server.log"
KEEPALIVE_LOCK="$STATE/keepalive.lock"
WIN32="/mnt/c/Windows/System32"
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then PLATFORM=wsl
elif [[ "$(uname -s)" == Darwin ]]; then PLATFORM=mac
else PLATFORM=linux; fi

usage() {
  cat <<EOF
Usage: clida [open|start|stop|restart|status|serve|url|shortcut]

  open     (default) start the server if needed and open the window, or bring the open one to the front
  app      like open; on WSL it then keeps WSL alive while the server runs (desktop shortcut target)
  start    start the server in the background only
  stop     stop the server; asks first if sessions are running (--force: don't ask)
  restart  stop + start (same question, same --force); an open window reloads by itself, else one opens
  status   show whether the server runs and how many sessions it hosts
  serve    run the server in the foreground (logs to the terminal)
  url      print a one-time login URL (valid 60 s), e.g. for another browser
  shortcut create or update the CLIDA shortcut (WSL: Windows desktop, macOS: ~/Applications)
EOF
}

healthy() { curl -fsS -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/healthz" 2>/dev/null; }

# Call the local API; the token goes in via stdin so it never shows up in `ps`.
local_api() {
  printf 'cookie = "clida_token=%s"\n' "$(cat "$STATE/token")" |
    curl -fsS --max-time 2 -K - -X "$1" -H "Host: localhost:$PORT" "http://127.0.0.1:$PORT$2"
}

# npm is only needed for the one-time install below; fetch it with the system's package manager
# if it is missing (a fresh Ubuntu/WSL has no npm).
ensure_npm() {
  command -v npm >/dev/null && return 0
  local sudo=""
  if [[ "$PLATFORM" == mac ]]; then
    if command -v brew >/dev/null; then
      echo "clida: npm not found, installing Node.js with Homebrew ..." >&2
      brew install node
    fi
  elif command -v apt-get >/dev/null; then
    if (( $(id -u) != 0 )); then
      sudo=sudo
      # The desktop shortcut has no terminal to ask for the sudo password.
      if [[ ! -t 0 ]] && ! sudo -n true 2>/dev/null; then
        echo "clida: npm not found; run 'sudo apt-get update && sudo apt-get install -y npm' in a terminal." >&2
        exit 1
      fi
    fi
    echo "clida: npm not found, installing it with apt (sudo may ask for your password) ..." >&2
    $sudo apt-get update
    $sudo apt-get install -y npm
  fi
  command -v npm >/dev/null && return 0
  echo "clida: npm not found; install Node.js/npm (https://nodejs.org) and run clida again." >&2
  exit 1
}

ensure_deps() {
  if [[ ! -f "$ROOT/node_modules/@xterm/xterm/lib/xterm.mjs" ]]; then
    ensure_npm
    echo "clida: installing frontend libraries (one-time npm install) ..." >&2
    (cd "$ROOT" && npm install --no-audit --no-fund --silent)
  fi
}

start_server() {
  healthy && return 0
  ensure_deps
  mkdir -p -m 700 "$STATE"
  cd "$ROOT"
  # --detach forks into its own session, so closing this terminal does not take the server along.
  python3 -m clida --port "$PORT" --detach >>"$LOG" 2>&1 </dev/null
  for _ in $(seq 1 50); do
    healthy && return 0
    sleep 0.1
  done
  echo "clida: server did not come up, see $LOG" >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
}

# A one-time ticket (valid 60 s) instead of the token, so the token never lands in browser history.
login_url() {
  local ticket
  ticket="$(local_api POST /api/login-ticket | python3 -c 'import json, sys; print(json.load(sys.stdin)["ticket"])')"
  echo "http://localhost:$PORT/?ticket=$ticket"
}

open_window_wsl() {
  local browser
  for browser in 'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe' \
                 'C:\Program Files\Google\Chrome\Application\chrome.exe'; do
    if [[ -x "$(wslpath -u "$browser")" ]]; then
      # Start-Process detaches the browser from our console. Started directly, it would die with
      # the hidden console of the desktop shortcut as soon as this script exits.
      (cd /mnt/c && "$WIN32/WindowsPowerShell/v1.0/powershell.exe" -NoProfile -NonInteractive -Command \
        "Start-Process -FilePath '$browser' -ArgumentList '--app=$1','--window-size=1440,920'") >/dev/null 2>&1
      return 0
    fi
  done
  return 1
}

open_window_mac() {
  local app
  # Only Chromium browsers have app windows; Safari would open a normal tab.
  for app in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium"; do
    if [[ -d "/Applications/$app.app" || -d "$HOME/Applications/$app.app" ]]; then
      open -na "$app" --args --app="$1" --window-size=1440,920
      return 0
    fi
  done
  open "$1"
}

open_window_linux() {
  local browser
  for browser in google-chrome chromium chromium-browser microsoft-edge brave-browser; do
    if command -v "$browser" >/dev/null; then
      nohup "$browser" --app="$1" --window-size=1440,920 >/dev/null 2>&1 &
      return 0
    fi
  done
  command -v xdg-open >/dev/null || return 1
  xdg-open "$1" >/dev/null 2>&1 &
}

# Windows the server counts as open: 0 when it does not run, or runs code that does not count them.
windows_open() {
  is_server "$(cat "$STATE/server.pid" 2>/dev/null || true)" || { echo 0; return; }
  local_api GET /api/status 2>/dev/null |
    python3 -c 'import json, sys; print(json.load(sys.stdin).get("windows", 0))' 2>/dev/null || echo 0
}

# CLIDA only once: an open window comes to the front; only without one does a new one open.
show_window() {
  if (( $(windows_open) > 0 )) && "focus_window_$PLATFORM"; then
    echo "CLIDA is already open; its window is in front now."
  else
    open_window
  fi
}

# Found by class (a Chromium window) and exact title, so an Explorer window of a folder named
# clida is never taken. Windows may refuse the focus to a background program; then the window
# flashes in the taskbar instead.
focus_window_wsl() {
  local script
  script='Add-Type -AssemblyName UIAutomationClient
$auto = [System.Windows.Automation.AutomationElement]
$chromium = New-Object System.Windows.Automation.PropertyCondition($auto::ClassNameProperty, "Chrome_WidgetWin_1")
foreach ($w in $auto::RootElement.FindAll([System.Windows.Automation.TreeScope]::Children, $chromium)) {
  if ($w.Current.Name -cnotmatch "^(\(\d+\) )?CLIDA$") { continue }
  $window = $w.GetCurrentPattern([System.Windows.Automation.WindowPattern]::Pattern)
  if ($window.Current.WindowVisualState -eq "Minimized") { $window.SetWindowVisualState("Normal") }
  $w.SetFocus()
  exit 0
}
exit 1'
  (cd /mnt/c && "$WIN32/WindowsPowerShell/v1.0/powershell.exe" -NoProfile -NonInteractive -EncodedCommand \
    "$(python3 -c 'import base64, sys; print(base64.b64encode(sys.stdin.read().encode("utf-16-le")).decode())' <<<"$script")") >/dev/null 2>&1
}

# Not built for macOS and Linux yet: there a second window opens and the page steps aside (app.js).
focus_window_mac() { return 1; }
focus_window_linux() { return 1; }

open_window() {
  local url
  url="$(login_url)"
  [[ "$PLATFORM" != wsl ]] || windows_reaches_server || warn_unreachable
  "open_window_$PLATFORM" "$url" || echo "Open in a browser: $url"
}

# Windows reaches the server through WSL's localhost relay (NAT networking). That relay can hang on
# one port, and the window then spins forever. So check from the Windows side first.
windows_reaches_server() {
  local curl="$WIN32/curl.exe" _
  [[ -x "$curl" ]] || return 0
  for _ in 1 2 3 4 5; do  # a new listener takes the relay a moment to pick up
    (cd /mnt/c && "$curl" -fsS -o NUL --noproxy '*' --max-time 1.5 "http://localhost:$PORT/healthz") >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}

# Said in a message box too: the desktop shortcut has no console to print to.
warn_unreachable() {
  local text lang
  lang="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("language", "de"))' "$STATE/settings.json" 2>/dev/null || echo de)"
  if [[ "$lang" == en ]]; then
    text="Windows cannot reach CLIDA at localhost:$PORT, although the server runs in WSL. WSL's port forwarding is stuck.

Fix: run \"wsl --shutdown\" in PowerShell or Win+R, then open CLIDA again. This ends all WSL processes."
  else
    text="Windows erreicht CLIDA unter localhost:$PORT nicht, obwohl der Server in WSL läuft. Die Portweiterleitung von WSL hängt.

Abhilfe: \"wsl --shutdown\" in PowerShell oder Win+R ausführen, dann CLIDA neu öffnen. Das beendet alle WSL-Prozesse."
  fi
  echo "clida: $text" >&2
  (cd /mnt/c && CLIDA_MSG="$text" WSLENV="${WSLENV:+$WSLENV:}CLIDA_MSG" "$WIN32/WindowsPowerShell/v1.0/powershell.exe" \
    -NoProfile -NonInteractive -Command 'Add-Type -AssemblyName PresentationFramework; [void][System.Windows.MessageBox]::Show($env:CLIDA_MSG, "CLIDA")' \
    >/dev/null 2>&1 &)
}

# WSL shuts down once no Windows-side wsl.exe client is left, taking the server with it.
# A headless wsl.exe that waits while the server is up prevents that. Not needed elsewhere.
keepalive() {
  [[ "$PLATFORM" == wsl ]] || return 0
  exec 9>"$KEEPALIVE_LOCK"
  flock -n 9 || return 0
  local misses=0
  while (( misses < 3 )); do
    if healthy; then misses=0; else misses=$((misses + 1)); fi
    sleep 15
  done
}

ensure_keepalive() {
  [[ "$PLATFORM" == wsl && -x "$WIN32/WindowsPowerShell/v1.0/powershell.exe" ]] || return 0
  flock -n "$KEEPALIVE_LOCK" true || return 0  # one is already running
  # Started from the Windows side, so it does not hang on this terminal's interop session.
  (cd /mnt/c && "$WIN32/WindowsPowerShell/v1.0/powershell.exe" -NoProfile -NonInteractive -Command \
    "Start-Process -WindowStyle Hidden -FilePath wsl.exe -ArgumentList '-d','$WSL_DISTRO_NAME','-e','$ROOT/bin/clida','keepalive'" \
    >/dev/null 2>&1 &)
}

make_shortcut_wsl() {
  local appdata dir script
  appdata="$(cd /mnt/c && "$WIN32/cmd.exe" /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')"
  dir="$(wslpath "$appdata")/clida"
  mkdir -p "$dir"
  cp "$ROOT/static/icon.ico" "$dir/clida.ico"
  # conhost --headless runs wsl.exe without a console window.
  script=$(cat <<EOF
\$ProgressPreference = 'SilentlyContinue'
\$desktop = [Environment]::GetFolderPath('Desktop')
\$path = Join-Path \$desktop 'CLIDA.lnk'
\$link = (New-Object -ComObject WScript.Shell).CreateShortcut(\$path)
\$link.TargetPath = Join-Path \$env:SystemRoot 'System32\\conhost.exe'
\$link.Arguments = '--headless ' + (Join-Path \$env:SystemRoot 'System32\\wsl.exe') + ' -d $WSL_DISTRO_NAME -e bash -lc "$ROOT/bin/clida app"'
\$link.IconLocation = '$appdata\\clida\\clida.ico,0'
\$link.WorkingDirectory = \$env:USERPROFILE
\$link.Description = 'Claude Code CLI im Desktop-Fenster (WSL: $WSL_DISTRO_NAME)'
\$link.Save()
\$path
EOF
)
  (cd /mnt/c && "$WIN32/WindowsPowerShell/v1.0/powershell.exe" -NoProfile -NonInteractive -EncodedCommand \
    "$(python3 -c 'import base64, sys; print(base64.b64encode(sys.stdin.read().encode("utf-16-le")).decode())' <<<"$script")") \
    | tr -d '\r'
}

# A small AppleScript app in ~/Applications, so CLIDA starts from Launchpad, Spotlight or the Dock.
make_shortcut_mac() {
  local app="$HOME/Applications/CLIDA.app" work
  work="$(mktemp -d)"
  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  # Apps start with a minimal PATH, so add the usual homes of claude, python3 and npm.
  cat >"$work/clida.applescript" <<EOF
do shell script "export PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\"; '$ROOT/bin/clida' >/dev/null 2>&1"
EOF
  osacompile -o "$app" "$work/clida.applescript"
  if command -v iconutil >/dev/null && [[ -f "$ROOT/static/icon-1024.png" ]]; then
    mkdir "$work/clida.iconset"
    for size in 16 32 128 256 512; do
      sips -z "$size" "$size" "$ROOT/static/icon-1024.png" --out "$work/clida.iconset/icon_${size}x${size}.png" >/dev/null
      sips -z $((size * 2)) $((size * 2)) "$ROOT/static/icon-1024.png" --out "$work/clida.iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns "$work/clida.iconset" -o "$app/Contents/Resources/applet.icns"
    touch "$app"  # make Finder pick up the new icon
  fi
  rm -rf "$work"
  echo "$app"
}

make_shortcut() {
  case "$PLATFORM" in
    wsl) make_shortcut_wsl ;;
    mac) make_shortcut_mac ;;
    *) echo "clida: shortcuts are only supported on WSL and macOS" >&2; exit 1 ;;
  esac
}

# True only if the pid really is our server; after a crash or `wsl --shutdown` server.pid
# stays behind, and the number may belong to some other process by now.
is_server() {
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  local cmdline
  cmdline="$(ps -o command= -p "$1" 2>/dev/null)" || return 1
  [[ "$cmdline" == *"-m clida --port $PORT"* ]]
}

stop_server() {
  local pid
  pid="$(cat "$STATE/server.pid" 2>/dev/null || true)"
  if ! is_server "$pid"; then
    rm -f "$STATE/server.pid"
    echo "clida is not running."
    return 0
  fi
  # Stopping ends every session hosted here - possibly the very one that runs this command.
  local running answer
  running="$(local_api GET /api/status 2>/dev/null | python3 -c '
import json, sys
print(sum(t["status"] != "exited" for t in json.load(sys.stdin)["terminals"]))' 2>/dev/null || echo 0)"
  if (( running > 0 )) && [[ "$FORCE" != 1 ]]; then
    if [[ -t 0 ]]; then
      read -r -p "$running session(s) still running in clida and will be ended. Stop anyway? [y/N] " answer
      [[ "$answer" =~ ^[yYjJ] ]] || { echo "Aborted."; return 1; }
    else
      echo "clida: $running session(s) still running; use 'clida stop --force'." >&2
      return 1
    fi
  fi
  kill "$pid"
  for _ in $(seq 1 80); do
    kill -0 "$pid" 2>/dev/null || { echo "clida stopped."; return 0; }
    sleep 0.1
  done
  echo "clida did not stop in time (pid $pid)." >&2
  return 1
}

FORCE=0
[[ "${2:-}" == "--force" ]] && FORCE=1

case "${1:-open}" in
  open) start_server; show_window; ensure_keepalive ;;
  app) start_server; show_window; keepalive ;;
  keepalive) keepalive ;;
  start) start_server; ensure_keepalive; echo "clida runs on http://localhost:$PORT" ;;
  stop) stop_server ;;
  restart)
    # An open window reloads by itself once the new server is up; a second one would only be in the way.
    windows="$(windows_open)"
    stop_server; start_server
    if (( windows > 0 )); then echo "clida restarted; the open window reloads by itself."; else open_window; fi
    ensure_keepalive ;;
  status)
    if healthy; then
      echo "clida runs on http://localhost:$PORT (pid $(cat "$STATE/server.pid" 2>/dev/null || echo '?'))"
      local_api GET /api/status | python3 -c '
import json, sys
d = json.load(sys.stdin)
live = [t for t in d["terminals"] if t["status"] != "exited"]
print(f"{len(live)} session(s) running in clida")
for t in live:
    print("  {status:<8} {cwd}  {session_id}".format(**t))'
    else
      echo "clida is not running."
    fi
    ;;
  serve) ensure_deps; cd "$ROOT"; exec python3 -m clida --port "$PORT" ;;
  url) start_server; login_url ;;
  shortcut) make_shortcut ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
